import Link from"next/link";import{Container}from"@/components/ui/container";import type{Internship}from"../types/internships.types";import{internshipStatusConfig}from"../utils/internships.utils";
function List({title,items}:{title:string;items:string[]}){return <section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">{title}</h2><ul className="mt-4 space-y-3">{items.map(x=><li key={x} className="flex gap-3 text-sm leading-6 text-slate-600"><span className="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#1B519F]"/>{x}</li>)}</ul></section>}
export function InternshipDetails({internship}:{internship:Internship}){const status=internshipStatusConfig[internship.status];const facts=[["Organization",internship.organizationName],["Field",internship.field],["Location",internship.location],["Duration",internship.duration],["Work Mode",internship.workMode],["Status",status.label]];return <><section className="bg-[#F5F9FF] py-8"><Container><Link href="/opportunities/internships" className="text-xs font-black text-[#1B519F]">Back to Internships</Link><div className="mt-5 rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><div className="flex gap-5"><span className="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-[#1B519F] text-xl font-black text-white">{internship.organizationName[0]}</span><div><div className="flex gap-2"><span className="rounded-full bg-[#FFF3DF] px-2 py-1 text-[9px] font-black uppercase text-[#F59223]">Demo</span><span className="rounded-full bg-emerald-50 px-2 py-1 text-[9px] font-black uppercase text-emerald-700">{status.label}</span></div><h1 className="mt-3 text-[clamp(2rem,4vw,3.2rem)] font-black leading-tight text-[#1B519F]">{internship.title}</h1><p className="mt-1 text-sm font-bold text-slate-500">{internship.organizationName}</p><div className="mt-4 flex flex-wrap gap-3 text-xs font-semibold text-slate-500"><span> {internship.location}</span><span> {internship.duration}</span><span> {internship.workMode}</span><span>{internship.field}</span></div></div></div></div></Container></section><section className="bg-[#FBFDFF] py-12"><Container className="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_320px]"><main className="space-y-5"><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">Internship Overview</h2><p className="mt-4 text-sm leading-7 text-slate-600">{internship.shortDescription}</p><p className="mt-3 rounded-xl bg-[#FFF9EF] p-3 text-xs leading-5 text-[#F59223]">This is a fictional development fixture, not a live vacancy. No organization relationship is implied.</p></section><List title="What You Will Learn" items={internship.learningOutcomes}/><List title="Responsibilities" items={internship.responsibilities}/><List title="Requirements" items={internship.requirements}/><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">Skills You Will Practice</h2><div className="mt-4 flex flex-wrap gap-2">{internship.skills.map(x=><span key={x} className="rounded-full bg-[#EEF5FF] px-3 py-1.5 text-xs font-bold text-[#1B519F]">{x}</span>)}</div></section><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">Eligibility</h2><p className="mt-4 text-sm leading-7 text-slate-600">{internship.eligibility}.</p></section><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">Duration &amp; Schedule</h2><p className="mt-4 text-sm text-slate-600">This {internship.duration.toLowerCase()} internship is offered in a {internship.workMode.toLowerCase()} work mode. Schedule details have not been supplied.</p></section><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">About the Organization</h2><p className="mt-4 text-sm leading-7 text-slate-600">{internship.organizationName} is a fictional name used only to test this interface.</p></section><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">Application Information</h2><p className="mt-4 text-sm leading-7 text-slate-600">The application form is available for interface testing. Submissions are not stored until a secure application service is connected.</p></section></main><aside className="lg:sticky lg:top-28"><div className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_12px_32px_rgba(6,59,134,.08)]"><div className="bg-[#1B519F] p-5 text-white"><h2 className="text-lg font-black">Internship Summary</h2></div><dl className="divide-y divide-slate-100 p-5">{facts.map(([a,b])=><div key={a} className="flex justify-between gap-4 py-3 text-xs"><dt className="text-slate-500">{a}</dt><dd className="text-right font-black text-[#1B519F]">{b}</dd></div>)}</dl><div className="px-5 pb-5">{status.canApply?<Link href={`/opportunities/internships/${internship.slug}/apply`} className="flex h-11 items-center justify-center rounded-xl bg-[#1B519F] text-sm font-black text-white hover:bg-[#174783]">Apply Now</Link>:<p className="rounded-xl bg-slate-100 p-3 text-center text-xs font-bold text-slate-500">{status.label}</p>}<Link href="/opportunities/internships" className="mt-3 flex justify-center text-xs font-bold text-[#1B519F]">Browse more internships</Link></div></div></aside></Container></section></>}


import Link from "next/link";

import {
  BrandHoverCard,
  getBrandHoverDirection,
} from "@/components/ui/brand-hover-card";

import type { Internship } from "../types/internships.types";
import { internshipStatusConfig } from "../utils/internships.utils";

interface InternshipCardProps {
  internship: Internship;
  saved: boolean;
  onSave: () => void;
  featured?: boolean;
  index?: number;
}

export function InternshipCard({
  internship,
  saved,
  onSave,
  featured = false,
  index = 0,
}: InternshipCardProps) {
  const status = internshipStatusConfig[internship.status];
  const direction = getBrandHoverDirection(index);

  return (
    <BrandHoverCard
      direction={direction}
      className={featured ? "border-[#1B519F]/20" : ""}
    >
      <article className="relative flex h-full min-h-[250px] flex-col p-4">
        <div className="flex gap-3">
          <span
            aria-hidden="true"
            className="
              flex h-10 w-10 shrink-0 items-center justify-center
              rounded-xl bg-[#1B519F]
              text-base font-black text-white
              transition-all duration-500
              group-hover:scale-105
              group-hover:!bg-white
              group-hover:!text-[#1B519F]
              motion-reduce:transform-none
            "
          >
            {internship.organizationName[0]}
          </span>

          <div className="min-w-0 flex-1">
            <div className="flex items-start justify-between gap-2">
              <div className="min-w-0">
                <h3
                  className="
                    text-[14px] font-black leading-5 text-[#1B519F]
                    transition-colors duration-500
                    group-hover:!text-white
                  "
                >
                  {internship.title}
                </h3>

                <p
                  className="
                    mt-0.5 text-[10px] font-semibold text-slate-500
                    transition-colors duration-500
                    group-hover:!text-white/80
                  "
                >
                  {internship.organizationName}
                </p>
              </div>

              <div className="flex shrink-0 gap-1">
                {featured ? (
                  <span
                    className="
                      rounded-full bg-[#FFF3DF]
                      px-2 py-1 text-[7px] font-black uppercase
                      text-[#F59223]
                      transition-colors duration-500
                      group-hover:!bg-white/15
                      group-hover:!text-white
                    "
                  >
                    Featured
                  </span>
                ) : null}

                {internship.demoOnly ? (
                  <span
                    className="
                      rounded-full bg-slate-100
                      px-2 py-1 text-[7px] font-black uppercase
                      text-slate-500
                      transition-colors duration-500
                      group-hover:!bg-white/15
                      group-hover:!text-white
                    "
                  >
                    Demo
                  </span>
                ) : null}
              </div>
            </div>

            <div
              className="
                mt-2 flex flex-wrap gap-x-2.5 gap-y-1
                text-[9px] font-semibold text-slate-500
                transition-colors duration-500
                group-hover:!text-white/80
              "
            >
              <span>{internship.location}</span>
              <span>{internship.duration}</span>
              <span>{internship.workMode}</span>
              <span>{internship.field}</span>
            </div>

            <div className="mt-2.5 flex flex-wrap gap-1">
              {internship.skills.map((skill) => (
                <span
                  key={skill}
                  className="
                    rounded-full bg-[#EEF5FF]
                    px-2 py-1
                    text-[8px] font-bold text-[#1B519F]
                    transition-colors duration-500
                    group-hover:!bg-white/15
                    group-hover:!text-white
                  "
                >
                  {skill}
                </span>
              ))}
            </div>

            <p
              className="
                mt-2.5 line-clamp-3
                text-[10px] leading-[1.55] text-slate-600
                transition-colors duration-500
                group-hover:!text-white/90
              "
            >
              {internship.shortDescription}
            </p>
          </div>
        </div>

        <div
          className="
            mt-auto flex items-center gap-2
            border-t border-slate-100 pt-3
            transition-colors duration-500
            group-hover:border-white/20
          "
        >
          <button
            type="button"
            aria-pressed={saved}
            onClick={onSave}
            className="
              mr-auto shrink-0
              text-[9px] font-bold text-slate-600
              transition-colors duration-300
              hover:text-[#1B519F]
              group-hover:!text-white
            "
          >
            {saved ? "Saved" : "Save"}
          </button>

          <Link
            href={`/opportunities/internships/${internship.slug}`}
            className="
              shrink-0 rounded-lg
              border border-[#1B519F]/30
              px-2.5 py-1.5
              text-[9px] font-black text-[#1B519F]
              transition-all duration-300
              hover:bg-[#EEF5FF]
              group-hover:!border-white/70
              group-hover:!bg-white/10
              group-hover:!text-white
            "
          >
            View Details
          </Link>

          {status.canApply ? (
            <Link
              href={`/opportunities/internships/${internship.slug}/apply`}
              className="
                shrink-0 rounded-lg bg-[#1B519F]
                px-2.5 py-1.5
                text-[9px] font-black text-white
                transition-all duration-300
                hover:bg-[#174783]
                group-hover:!bg-white
                group-hover:!text-[#1B519F]
              "
            >
              Apply Now
            </Link>
          ) : (
            <span
              className="
                shrink-0 rounded-lg bg-slate-100
                px-2.5 py-1.5
                text-[9px] font-bold text-slate-500
                group-hover:!bg-white/15
                group-hover:!text-white
              "
            >
              {status.label}
            </span>
          )}
        </div>
      </article>
    </BrandHoverCard>
  );
}


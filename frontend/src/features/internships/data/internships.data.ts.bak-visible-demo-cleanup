export const getPublishedInternships = () =>
  internships.filter(
    (item) => item.published && item.status !== "draft",
  );

export const getFeaturedInternships = () =>
  getPublishedInternships().filter(
    (item) => item.featured,
  );

export const getInternshipBySlug = (slug: string) =>
  getPublishedInternships().find(
    (item) => item.slug === slug,
  );

export const internshipTracks =
  getPublishedInternships().map((item) => ({
    id: item.slug,
    eyebrow: item.field,
    title: item.title,
    shortDescription: item.shortDescription,
    meta: `${item.location} - ${item.duration}`,
    href: `/opportunities/internships/${item.slug}`,
  }));

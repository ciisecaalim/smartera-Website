export const getPublishedTrainings = () => trainingActivities
  .filter((item) => item.published)
  .toSorted((a, b) => b.startDate.localeCompare(a.startDate));
export const getTrainingBySlug = (slug: string) => getPublishedTrainings().find((item) => item.slug === slug);
export const getTrainingsByStatus = (status: TrainingStatus) => getPublishedTrainings().filter((item) => item.status === status);

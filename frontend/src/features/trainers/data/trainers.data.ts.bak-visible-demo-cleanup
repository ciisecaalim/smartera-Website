export function getPublishedTrainers() {
  return trainers.filter((trainer) => trainer.published);
}

export function getTrainerBySlug(slug: string) {
  return trainers.find(
    (trainer) =>
      trainer.slug === slug &&
      trainer.published,
  );
}


"use client";

import {
  useState,
  type FormEvent,
} from "react";
import { submitPublicForm } from "@/features/web-submissions/public-submissions.service";
import { PublicSubmissionToast } from "@/features/web-submissions/public-submission-toast";

export function TrainerRequestForm({
  trainerName,
  trainerSlug,
}: {
  trainerName: string;
  trainerSlug: string;
}) {
  const [notice, setNotice] =
    useState(false);
  const [submissionError, setSubmissionError] = useState("");

  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);

  const minimumPreferredDate =
    `${tomorrow.getFullYear()}-${String(tomorrow.getMonth() + 1).padStart(2, "0")}-${String(tomorrow.getDate()).padStart(2, "0")}`;

  async function submit(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();
    setSubmissionError("");
    const form = event.currentTarget;

    try {
      await submitPublicForm("trainers", form, {
        trainerName,
        trainerSlug,
      });

      setNotice(true);
      form.reset();
    } catch (error) {
      setSubmissionError(
        error instanceof Error
          ? error.message
          : "Unable to submit your request. Please try again.",
      );
    }
  }

  const input =
    "trainer-input mt-2 h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-900 outline-none focus:border-[#1B519F] focus:ring-2 focus:ring-[#1B519F]/10";

  return (
    <form
      onSubmit={submit}
      className="trainer-card rounded-[22px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
    >
      <PublicSubmissionToast message={submissionError} variant="error" onDismiss={() => setSubmissionError("")} />
      <p className="text-xs font-black uppercase tracking-[0.18em] text-[#F59223]">
        Corporate Request
      </p>

      <h2 className="mt-2 text-2xl font-black text-[#1B519F]">
        Request This Trainer
      </h2>

      <p className="trainer-muted mt-3 text-sm leading-6 text-slate-600">
        Your request will go through
        Smartera Hub. Smartera will review
        the training requirement and
        coordinate with the trainer.
      </p>

      <div className="mt-6 rounded-xl bg-[#EEF5FF] p-4">
        <p className="text-[10px] font-black uppercase tracking-wider text-slate-400">
          Selected Trainer
        </p>

        <p className="mt-1 text-sm font-black text-[#1B519F]">
          {trainerName}
        </p>
      </div>

      <div className="mt-6 grid gap-5 sm:grid-cols-2">
        <label className="text-xs font-bold text-[#1B519F]">
          Company / Organization Name
          <input
            name="organizationName"
            minLength={2}
            aria-describedby="organizationNameHelp"
            required
            maxLength={150}
            className={input}
          />
          <span id="organizationNameHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Required - 2 to 150 characters. Enter the real company or organization name.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Contact Person
          <input
            name="contactPerson"
            minLength={2}
            aria-describedby="contactPersonHelp"
            required
            maxLength={100}
            className={input}
          />
          <span id="contactPersonHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Required - 2 to 100 characters. Enter the full name of the contact person.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Business Email
          <input
            name="email"
            aria-describedby="emailHelp"
            type="email"
            required
            maxLength={150}
            className={input}
          />
          <span id="emailHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Required - Valid business email - Maximum 150 characters.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Phone
          <input
            name="phone"
            aria-describedby="phoneHelp"
            type="tel"
            required
            pattern="[+0-9 \(\)\-]+"
            minLength={7}
            maxLength={20}
            className={input}
          />
          <span id="phoneHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Required - 7 to 15 digits - Maximum 20 characters including +, spaces, parentheses, and hyphen.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F] sm:col-span-2">
          Training Needed
          <input
            name="trainingNeeded"
            minLength={10}
            aria-describedby="trainingNeededHelp"
            required
            maxLength={180}
            placeholder="Example: Sales & Marketing Training"
            className={input}
          />
          <span id="trainingNeededHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Required - 10 to 180 characters. Briefly describe the training needed.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Number of Participants
          <input
            name="participants"
            aria-describedby="participantsHelp"
            type="number"
            min={1}
            max={5000}
            required
            className={input}
          />
          <span id="participantsHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Required - Enter a whole number from 1 to 5,000.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Preferred Date
          <input
            name="preferredDate"
            aria-describedby="preferredDateHelp"
            type="date"
            min={minimumPreferredDate}
            className={input}
          />
          <span id="preferredDateHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Optional - Only future dates are allowed. Today and past dates are blocked.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Training Mode
          <select
            name="trainingMode"
            aria-describedby="trainingModeHelp"
            required
            defaultValue=""
            className={input}
          >
            <option value="">
              Select mode
            </option>
            <option value="on-site">On-site</option>
            <option value="online">Online</option>
            <option value="hybrid">Hybrid</option>
          </select>
          <span id="trainingModeHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Required - Select On-site, Online, or Hybrid.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Location
          <input
            name="location"
            minLength={3}
            aria-describedby="locationHelp"
            maxLength={150}
            className={input}
          />
          <span id="locationHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Optional - If provided, use 3 to 150 meaningful characters.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F] sm:col-span-2">
          Expected Duration
          <input
            name="duration"
            minLength={2}
            aria-describedby="durationHelp"
            maxLength={100}
            placeholder="Example: 2 days"
            className={input}
          />
          <span id="durationHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Optional - 2 to 100 characters. Example: 2 days or 6 hours.
          </span>
        </label>

        <label className="text-xs font-bold text-[#1B519F] sm:col-span-2">
          Training Requirements / Message
          <textarea
            name="message"
            aria-describedby="messageHelp"
            required
            minLength={20}
            maxLength={2000}
            className="trainer-input mt-2 min-h-32 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-900 outline-none focus:border-[#1B519F] focus:ring-2 focus:ring-[#1B519F]/10"
          />
          <span id="messageHelp" className="mt-1 block text-[11px] leading-4 text-slate-500">
            Required - 20 to 2,000 characters. Clearly explain the training goals and requirements.
          </span>
        </label>
      </div>

      <PublicSubmissionToast message={notice ? "Your request has been submitted successfully." : ""} variant="success" onDismiss={() => setNotice(false)} />

      <button
        type="submit"
        className="mt-6 h-11 rounded-xl bg-[#1B519F] px-6 text-sm font-black text-white transition hover:bg-[#174783]"
      >
        Submit Trainer Request
      </button>

      <input
        type="hidden"
        name="trainerSlug"
        value={trainerSlug}
      />
    </form>
  );
}






"use client";

import Image from "next/image";
import Link from "next/link";
import {
  useEffect,
  useMemo,
  useState,
} from "react";

import type { Trainer } from "../types/trainer.types";
import { trainerAsset } from "../data/trainers.data";

const TRAINERS_PER_PAGE = 8;

export function TrainersBrowser({
  trainers,
  failed = false,
}: {
  trainers: Trainer[];
  failed?: boolean;
}) {
  const [q, setQ] = useState("");
  const [
    experienceRange,
    setExperienceRange,
  ] = useState("");

  const [page, setPage] = useState(1);

  const filtered = useMemo(() => {
    const needle =
      q.trim().toLowerCase();

    return trainers.filter((trainer) => {
      const years =
        Number(
          trainer.yearsExperience,
        ) || 0;

      const matchesExperience =
        !experienceRange ||
        (
          experienceRange === "1-3" &&
          years >= 1 &&
          years <= 3
        ) ||
        (
          experienceRange === "3-5" &&
          years > 3 &&
          years <= 5
        ) ||
        (
          experienceRange === "5-10" &&
          years > 5 &&
          years <= 10
        ) ||
        (
          experienceRange === "10+" &&
          years > 10
        );

      const matchesSearch =
        !needle ||
        [
          trainer.fullName,
          trainer.professionalTitle,
          trainer.specialization,
          ...trainer.skills,
        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase()
          .includes(needle);

      return (
        matchesExperience &&
        matchesSearch
      );
    });
  }, [
    trainers,
    q,
    experienceRange,
  ]);

  const totalPages = Math.max(
    1,
    Math.ceil(
      filtered.length /
        TRAINERS_PER_PAGE,
    ),
  );

  useEffect(() => {
    setPage(1);
  }, [q, experienceRange]);

  useEffect(() => {
    if (page > totalPages) {
      setPage(totalPages);
    }
  }, [page, totalPages]);

  const shown = useMemo(() => {
    const start =
      (page - 1) *
      TRAINERS_PER_PAGE;

    return filtered.slice(
      start,
      start + TRAINERS_PER_PAGE,
    );
  }, [filtered, page]);

  function changePage(
    nextPage: number,
  ) {
    const safePage = Math.min(
      Math.max(nextPage, 1),
      totalPages,
    );

    setPage(safePage);

    document
      .getElementById(
        "trainers-directory",
      )
      ?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
  }

  return (
    <section
      id="trainers-directory"
      className="px-4 pb-20 pt-10 sm:px-6 lg:px-8"
    >
      <div className="mx-auto max-w-7xl">

        <div className="flex flex-col gap-4 lg:flex-row lg:items-center">
          <label className="relative flex-1">
            <span className="sr-only">
              Search trainers
            </span>

            <input
              type="search"
              value={q}
              onChange={(event) =>
                setQ(
                  event.target.value,
                )
              }
              placeholder="Search trainers by name, skills, or expertise..."
              className="trainer-input h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm shadow-sm outline-none focus:border-[#1B519F]"
            />
          </label>

          <div className="w-full sm:w-auto">
            <label
              htmlFor="trainer-experience"
              className="sr-only"
            >
              Filter trainers by experience
            </label>

            <select
              id="trainer-experience"
              value={experienceRange}
              onChange={(event) =>
                setExperienceRange(
                  event.target.value,
                )
              }
              className="trainer-input h-12 w-full min-w-[220px] rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-[#1B519F] shadow-sm outline-none transition focus:border-[#1B519F] sm:w-auto"
            >
              <option value="">
                All Experience
              </option>

              <option value="1-3">
                1–3 Years Experience
              </option>

              <option value="3-5">
                3–5 Years Experience
              </option>

              <option value="5-10">
                5–10 Years Experience
              </option>

              <option value="10+">
                10+ Years Experience
              </option>
            </select>
          </div>
        </div>

        {failed ? (
          <Empty
            title="We're unable to load trainers right now."
            text="Please try again shortly."
          />
        ) : shown.length ? (
          <>
            <div className="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {shown.map(
                (trainer) => (
                  <article
                    key={
                      trainer.slug
                    }
                    className="trainer-card flex h-full flex-col rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl"
                  >
                    <div className="flex justify-center">
                      <div className="relative h-36 w-36 overflow-hidden rounded-[24px] bg-slate-100 ring-4 ring-[#EEF5FF]">
                        <Image
                          unoptimized={trainerAsset(
                            trainer.profileImage,
                          ).startsWith(
                            "http",
                          )}
                          src={trainerAsset(
                            trainer.profileImage,
                          )}
                          alt={
                            trainer.imageAlt ||
                            trainer.fullName
                          }
                          fill
                          sizes="144px"
                          className="object-cover object-[50%_20%]"
                        />
                      </div>
                    </div>

                    <div className="mt-5 flex flex-1 flex-col text-center">
                      <h2 className="text-xl font-black leading-tight text-[#1B519F]">
                        {
                          trainer.fullName
                        }
                      </h2>

                      <p className="mt-2 text-sm font-semibold text-slate-600">
                        {
                          trainer.professionalTitle
                        }
                      </p>

                      <p className="mt-2 text-sm font-black text-[#F59223]">
                        {
                          trainer.specialization
                        }
                      </p>

                      <div className="mt-4 flex flex-wrap justify-center gap-2">
                        {trainer.skills
                          .slice(0, 3)
                          .map(
                            (
                              skill,
                              index,
                            ) => (
                              <span
                                key={`${trainer.slug}-${skill}-${index}`}
                                className="rounded-full bg-[#EEF5FF] px-3 py-1.5 text-xs font-bold text-[#1B519F]"
                              >
                                {
                                  skill
                                }
                              </span>
                            ),
                          )}
                      </div>

                      <p className="mt-5 text-sm font-black text-[#1B519F]">
                        {
                          trainer.yearsExperience
                        }
                        + Years Experience
                      </p>

                      <p className="mt-3 line-clamp-2 text-sm leading-6 text-slate-500">
                        {
                          trainer.shortBio
                        }
                      </p>

                      <Link
                        href={
                          "/trainers/" +
                          trainer.slug
                        }
                        className="mt-6 inline-flex min-h-11 items-center justify-center self-center rounded-xl border border-[#1B65D8] px-6 py-2.5 text-sm font-bold text-[#1B519F] transition hover:bg-[#1B519F] hover:text-white"
                      >
                        See More →
                      </Link>
                    </div>
                  </article>
                ),
              )}
            </div>

            {totalPages > 1 ? (
              <div className="mt-10 flex flex-col items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white px-5 py-4 sm:flex-row">

                <p className="text-sm font-semibold text-slate-500">
                  Showing{" "}
                  {(page - 1) *
                    TRAINERS_PER_PAGE +
                    1}
                  –
                  {Math.min(
                    page *
                      TRAINERS_PER_PAGE,
                    filtered.length,
                  )}{" "}
                  of{" "}
                  {filtered.length}{" "}
                  trainers
                </p>

                <div className="flex items-center gap-3">
                  <button
                    type="button"
                    disabled={
                      page === 1
                    }
                    onClick={() =>
                      changePage(
                        page - 1,
                      )
                    }
                    className="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-5 text-sm font-bold text-[#1B519F] transition hover:border-[#1B519F] hover:bg-[#EEF5FF] disabled:cursor-not-allowed disabled:opacity-40"
                  >
                    ← Previous
                  </button>

                  <span className="flex min-h-11 min-w-[90px] items-center justify-center rounded-xl bg-[#EEF5FF] px-4 text-sm font-black text-[#1B519F]">
                    {page} /{" "}
                    {totalPages}
                  </span>

                  <button
                    type="button"
                    disabled={
                      page ===
                      totalPages
                    }
                    onClick={() =>
                      changePage(
                        page + 1,
                      )
                    }
                    className="inline-flex min-h-11 items-center justify-center rounded-xl bg-[#1B519F] px-5 text-sm font-bold text-white transition hover:bg-[#143f7d] disabled:cursor-not-allowed disabled:opacity-40"
                  >
                    Next →
                  </button>
                </div>
              </div>
            ) : null}
          </>
        ) : (
          <Empty
            title={
              q ||
              experienceRange
                ? "No trainers found for your search."
                : "No trainers are available right now."
            }
            text={
              q
                ? "Try another name, skill, or specialization."
                : ""
            }
          />
        )}
      </div>
    </section>
  );
}

function Empty({
  title,
  text,
}: {
  title: string;
  text: string;
}) {
  return (
    <div className="trainer-card mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <h2 className="text-lg font-black text-[#1B519F]">
        {title}
      </h2>

      {text ? (
        <p className="mt-2 text-sm text-slate-500">
          {text}
        </p>
      ) : null}
    </div>
  );
}
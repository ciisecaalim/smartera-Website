"use client";

import Link from "next/link";
import {
  FormEvent,
  useState,
} from "react";

const API =
  process.env.NEXT_PUBLIC_API_BASE_URL ??
  "http://localhost:5000/api";

const CV_MAX_BYTES = 700 * 1024;
const CERT_MAX_BYTES = 5 * 1024 * 1024;

const DAYS = [
  ["SUNDAY", "Sunday"],
  ["MONDAY", "Monday"],
  ["TUESDAY", "Tuesday"],
  ["WEDNESDAY", "Wednesday"],
  ["THURSDAY", "Thursday"],
  ["FRIDAY", "Friday"],
  ["SATURDAY", "Saturday"],
] as const;

type Certification = {
  id: number;
  name: string;
  issuer: string;
  issueDate: string;
  expiryDate: string;
  credentialId: string;
  credentialUrl: string;
  file: File | null;
};

type SuccessData = {
  applicationNumber: string;
  submittedAt: string;
};

type ApiError = {
  message?: string;
  errors?: Array<{
    message?: string;
  }>;
};

function splitValues(value: string) {
  return value
    .split(/[,\n]/)
    .map((item) => item.trim())
    .filter(Boolean);
}

function text(
  source: FormData,
  name: string,
) {
  return String(
    source.get(name) ?? "",
  ).trim();
}

function appendOptional(
  target: FormData,
  name: string,
  value: string,
) {
  if (value.trim()) {
    target.append(
      name,
      value.trim(),
    );
  }
}

export function TrainerApplicationForm() {
  const [
    hasTrainingExperience,
    setHasTrainingExperience,
  ] = useState(false);

  const [
    certifications,
    setCertifications,
  ] = useState<Certification[]>([]);

  const [
    submitting,
    setSubmitting,
  ] = useState(false);

  const [
    error,
    setError,
  ] = useState("");

  const [
    success,
    setSuccess,
  ] = useState<SuccessData | null>(
    null,
  );

  function addCertification() {
    setCertifications((current) => {
      if (current.length >= 10) {
        return current;
      }

      return [
        ...current,
        {
          id: Date.now(),
          name: "",
          issuer: "",
          issueDate: "",
          expiryDate: "",
          credentialId: "",
          credentialUrl: "",
          file: null,
        },
      ];
    });
  }

  function removeCertification(
    id: number,
  ) {
    setCertifications((current) =>
      current.filter(
        (item) => item.id !== id,
      ),
    );
  }

  function updateCertification(
    id: number,
    patch: Partial<Certification>,
  ) {
    setCertifications((current) =>
      current.map((item) =>
        item.id === id
          ? {
              ...item,
              ...patch,
            }
          : item,
      ),
    );
  }

  async function handleSubmit(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    setError("");

    const formElement =
      event.currentTarget;

    const raw =
      new FormData(formElement);

    const cv =
      raw.get("cv");

    if (!(cv instanceof File) || !cv.size) {
      setError(
        "Please upload your CV / Resume.",
      );
      return;
    }

    if (cv.size > CV_MAX_BYTES) {
      setError(
        "CV / Resume must not exceed 700 KB.",
      );
      return;
    }

    const cvName =
      cv.name.toLowerCase();

    if (
      !cvName.endsWith(".pdf") &&
      !cvName.endsWith(".doc") &&
      !cvName.endsWith(".docx")
    ) {
      setError(
        "CV must be a PDF, DOC, or DOCX file.",
      );
      return;
    }

    const selectedDays =
      raw
        .getAll("availableDays")
        .map(String);

    if (!selectedDays.length) {
      setError(
        "Select at least one available day.",
      );
      return;
    }

    if (
      !splitValues(
        text(raw, "expertiseAreas"),
      ).length
    ) {
      setError(
        "Add at least one expertise area.",
      );
      return;
    }

    for (
      const certification
      of certifications
    ) {
      if (
        !certification.name.trim() ||
        !certification.issuer.trim()
      ) {
        setError(
          "Each certification must include its name and issuing organization.",
        );
        return;
      }

      if (!certification.file) {
        setError(
          "Upload the PDF document for each certification you add.",
        );
        return;
      }

      if (
        certification.file.type !==
          "application/pdf" &&
        !certification.file.name
          .toLowerCase()
          .endsWith(".pdf")
      ) {
        setError(
          "Certification documents must be PDF files.",
        );
        return;
      }

      if (
        certification.file.size >
        CERT_MAX_BYTES
      ) {
        setError(
          "Each certification PDF must not exceed 5 MB.",
        );
        return;
      }
    }

    const payload =
      new FormData();

    payload.append(
      "fullName",
      text(raw, "fullName"),
    );

    payload.append(
      "email",
      text(raw, "email"),
    );

    payload.append(
      "phone",
      text(raw, "phone"),
    );

    payload.append(
      "currentJobTitle",
      text(
        raw,
        "currentJobTitle",
      ),
    );

    appendOptional(
      payload,
      "currentOrganization",
      text(
        raw,
        "currentOrganization",
      ),
    );

    payload.append(
      "yearsExperience",
      text(
        raw,
        "yearsExperience",
      ),
    );

    payload.append(
      "highestEducationLevel",
      text(
        raw,
        "highestEducationLevel",
      ),
    );

    appendOptional(
      payload,
      "fieldOfStudy",
      text(raw, "fieldOfStudy"),
    );

    appendOptional(
      payload,
      "linkedinUrl",
      text(raw, "linkedinUrl"),
    );

    appendOptional(
      payload,
      "portfolioUrl",
      text(raw, "portfolioUrl"),
    );

    payload.append(
      "expertiseAreas",
      splitValues(
        text(raw, "expertiseAreas"),
      ).join(","),
    );

    payload.append(
      "hasTrainingExperience",
      hasTrainingExperience
        ? "true"
        : "false",
    );

    if (hasTrainingExperience) {
      payload.append(
        "trainingExperienceYears",
        text(
          raw,
          "trainingExperienceYears",
        ),
      );

      payload.append(
        "trainingOrganizations",
        splitValues(
          text(
            raw,
            "trainingOrganizations",
          ),
        ).join(","),
      );

      payload.append(
        "trainingSubjects",
        splitValues(
          text(
            raw,
            "trainingSubjects",
          ),
        ).join(","),
      );

      appendOptional(
        payload,
        "learnersTrained",
        text(
          raw,
          "learnersTrained",
        ),
      );
    }

    payload.append(
      "preferredMode",
      text(raw, "preferredMode"),
    );

    payload.append(
      "availableDays",
      selectedDays.join(","),
    );

    payload.append(
      "preferredTime",
      text(raw, "preferredTime"),
    );

    payload.append(
      "motivation",
      text(raw, "motivation"),
    );

    payload.append(
      "practicalValue",
      text(raw, "practicalValue"),
    );

    appendOptional(
      payload,
      "additionalInformation",
      text(
        raw,
        "additionalInformation",
      ),
    );

    payload.append(
      "consent",
      "true",
    );

    const certificationMetadata =
      certifications.map((item) => ({
        name: item.name.trim(),
        issuer: item.issuer.trim(),
        issueDate:
          item.issueDate ||
          undefined,
        expiryDate:
          item.expiryDate ||
          undefined,
        credentialId:
          item.credentialId.trim() ||
          undefined,
        credentialUrl:
          item.credentialUrl.trim() ||
          undefined,
      }));

    payload.append(
      "certifications",
      JSON.stringify(
        certificationMetadata,
      ),
    );

    payload.append(
      "cv",
      cv,
      cv.name,
    );

    certifications.forEach(
      (item) => {
        if (item.file) {
          payload.append(
            "certificationFiles",
            item.file,
            item.file.name,
          );
        }
      },
    );

    try {
      setSubmitting(true);

      const response =
        await fetch(
          `${API}/web/trainers/applications`,
          {
            method: "POST",
            body: payload,
          },
        );

      const result =
        (await response.json()) as {
          success?: boolean;
          message?: string;
          data?: SuccessData;
          errors?: Array<{
            message?: string;
          }>;
        };

      if (
        !response.ok ||
        !result.success ||
        !result.data
      ) {
        const firstError =
          result.errors?.find(
            (item) => item.message,
          )?.message;

        throw new Error(
          firstError ||
            result.message ||
            "Unable to submit your application.",
        );
      }

      setSuccess({
        applicationNumber:
          result.data.applicationNumber,
        submittedAt:
          result.data.submittedAt,
      });

      formElement.reset();
      setCertifications([]);
      setHasTrainingExperience(
        false,
      );

      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    } catch (caught) {
      const apiError =
        caught as ApiError | Error;

      setError(
        apiError instanceof Error
          ? apiError.message
          : apiError.message ||
              "Unable to submit your application.",
      );
    } finally {
      setSubmitting(false);
    }
  }

  if (success) {
    return (
      <div className="rounded-3xl border border-emerald-200 bg-white p-8 shadow-sm sm:p-10">
        <div className="mx-auto max-w-2xl text-center">
          <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-2xl font-black text-emerald-700">
            ✓
          </div>

          <h2 className="mt-5 text-2xl font-black text-[#1B519F]">
            Application Submitted
          </h2>

          <p className="mt-3 text-sm leading-7 text-slate-600">
            Thank you for applying to
            become a trainer at
            Smartera Hub. Your
            application has been
            received successfully.
          </p>

          <div className="mt-6 rounded-2xl bg-slate-50 p-5">
            <p className="text-xs font-bold uppercase tracking-wider text-slate-500">
              Application Number
            </p>

            <p className="mt-2 break-all text-xl font-black text-[#1B519F]">
              {
                success.applicationNumber
              }
            </p>

            <p className="mt-3 text-xs text-slate-500">
              Submitted{" "}
              {new Date(
                success.submittedAt,
              ).toLocaleString()}
            </p>
          </div>

          <Link
            href="/trainers"
            className="mt-7 inline-flex min-h-11 items-center justify-center rounded-xl bg-[#1B519F] px-6 py-3 text-sm font-black text-white hover:bg-[#143f7d]"
          >
            Back to Trainers
          </Link>
        </div>
      </div>
    );
  }

  return (
    <form
      onSubmit={handleSubmit}
      className="space-y-8"
    >
      {error ? (
        <div
          role="alert"
          className="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-semibold text-red-700"
        >
          {error}
        </div>
      ) : null}

      <Section
        number="01"
        title="Personal Information"
        description="Basic contact information for your application."
      >
        <div className="grid gap-5 md:grid-cols-2">
          <Field
            label="Full Name"
            required
          >
            <input
              name="fullName"
              required
              minLength={3}
              maxLength={100}
              className={inputClass}
              placeholder="Your full name"
            />
          </Field>

          <Field
            label="Email Address"
            required
          >
            <input
              name="email"
              type="email"
              required
              className={inputClass}
              placeholder="name@example.com"
            />
          </Field>

          <Field
            label="Phone Number"
            required
          >
            <input
              name="phone"
              type="tel"
              required
              className={inputClass}
              placeholder="0612345678"
            />
          </Field>
        </div>
      </Section>

      <Section
        number="02"
        title="Professional Background"
        description="Tell us about your professional experience and expertise."
      >
        <div className="grid gap-5 md:grid-cols-2">
          <Field
            label="Current Job Title"
            required
          >
            <input
              name="currentJobTitle"
              required
              className={inputClass}
              placeholder="e.g. Software Engineer"
            />
          </Field>

          <Field label="Current Organization">
            <input
              name="currentOrganization"
              className={inputClass}
              placeholder="Company or organization"
            />
          </Field>

          <Field
            label="Years of Professional Experience"
            required
          >
            <input
              name="yearsExperience"
              type="number"
              required
              min={0}
              max={60}
              step={1}
              className={inputClass}
              placeholder="3"
            />
          </Field>

          <Field
            label="Highest Education Level"
            required
          >
            <input
              name="highestEducationLevel"
              required
              className={inputClass}
              placeholder="e.g. Bachelor's Degree"
            />
          </Field>

          <Field label="Field of Study">
            <input
              name="fieldOfStudy"
              className={inputClass}
              placeholder="e.g. Computer Science"
            />
          </Field>

          <Field label="LinkedIn URL">
            <input
              name="linkedinUrl"
              type="url"
              className={inputClass}
              placeholder="https://linkedin.com/in/..."
            />
          </Field>

          <Field label="Portfolio URL">
            <input
              name="portfolioUrl"
              type="url"
              className={inputClass}
              placeholder="https://..."
            />
          </Field>
        </div>

        <div className="mt-5">
          <Field
            label="Expertise Areas"
            required
            hint="Separate multiple areas with commas or new lines."
          >
            <textarea
              name="expertiseAreas"
              required
              rows={4}
              className={textareaClass}
              placeholder={"Data Analysis, Software Engineering, Digital Marketing"}
            />
          </Field>
        </div>
      </Section>

      <Section
        number="03"
        title="Training Experience"
        description="Share previous teaching or training experience if applicable."
      >
        <fieldset>
          <legend className="text-sm font-black text-slate-800">
            Do you have previous
            training experience?
          </legend>

          <div className="mt-3 flex flex-wrap gap-3">
            <label className={choiceClass}>
              <input
                type="radio"
                name="trainingExperienceChoice"
                checked={
                  hasTrainingExperience
                }
                onChange={() =>
                  setHasTrainingExperience(
                    true,
                  )
                }
              />
              Yes
            </label>

            <label className={choiceClass}>
              <input
                type="radio"
                name="trainingExperienceChoice"
                checked={
                  !hasTrainingExperience
                }
                onChange={() =>
                  setHasTrainingExperience(
                    false,
                  )
                }
              />
              No
            </label>
          </div>
        </fieldset>

        {hasTrainingExperience ? (
          <div className="mt-6 grid gap-5 md:grid-cols-2">
            <Field
              label="Years of Training Experience"
              required
            >
              <input
                name="trainingExperienceYears"
                type="number"
                required={
                  hasTrainingExperience
                }
                min={0}
                max={60}
                step={1}
                className={inputClass}
              />
            </Field>

            <Field label="Approx. Learners Trained">
              <input
                name="learnersTrained"
                type="number"
                min={0}
                step={1}
                className={inputClass}
              />
            </Field>

            <Field
              label="Organizations Trained"
              hint="Separate with commas or new lines."
            >
              <textarea
                name="trainingOrganizations"
                rows={3}
                className={textareaClass}
              />
            </Field>

            <Field
              label="Training Subjects"
              hint="Separate with commas or new lines."
            >
              <textarea
                name="trainingSubjects"
                rows={3}
                className={textareaClass}
              />
            </Field>
          </div>
        ) : null}
      </Section>

      <Section
        number="04"
        title="Availability"
        description="Tell us how and when you prefer to train."
      >
        <div className="grid gap-5 md:grid-cols-2">
          <Field
            label="Preferred Training Mode"
            required
          >
            <select
              name="preferredMode"
              required
              defaultValue=""
              className={inputClass}
            >
              <option
                value=""
                disabled
              >
                Select training mode
              </option>
              <option value="ONSITE">
                On-site
              </option>
              <option value="REMOTE">
                Remote
              </option>
              <option value="HYBRID">
                Hybrid
              </option>
            </select>
          </Field>

          <Field
            label="Preferred Time"
            required
          >
            <select
              name="preferredTime"
              required
              defaultValue=""
              className={inputClass}
            >
              <option
                value=""
                disabled
              >
                Select preferred time
              </option>
              <option value="MORNING">
                Morning
              </option>
              <option value="AFTERNOON">
                Afternoon
              </option>
              <option value="EVENING">
                Evening
              </option>
              <option value="FLEXIBLE">
                Flexible
              </option>
            </select>
          </Field>
        </div>

        <fieldset className="mt-5">
          <legend className="text-sm font-black text-slate-800">
            Available Days{" "}
            <span className="text-red-500">
              *
            </span>
          </legend>

          <div className="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
            {DAYS.map(
              ([value, label]) => (
                <label
                  key={value}
                  className="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-slate-700"
                >
                  <input
                    type="checkbox"
                    name="availableDays"
                    value={value}
                    className="h-4 w-4"
                  />
                  {label}
                </label>
              ),
            )}
          </div>
        </fieldset>
      </Section>

      <Section
        number="05"
        title="CV & Certifications"
        description="Upload your CV and optional professional certification documents."
      >
        <Field
          label="CV / Resume"
          required
          hint="PDF, DOC, or DOCX. Maximum size: 700 KB."
        >
          <input
            name="cv"
            type="file"
            required
            accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            className={fileClass}
          />
        </Field>

        <div className="mt-7 border-t border-slate-200 pt-6">
          <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
            <div>
              <h3 className="text-base font-black text-[#1B519F]">
                Certifications
              </h3>

              <p className="mt-1 text-xs text-slate-500">
                Optional. Add up to 10
                certifications. Each
                uploaded document must be
                PDF.
              </p>
            </div>

            <button
              type="button"
              onClick={addCertification}
              disabled={
                certifications.length >= 10
              }
              className="rounded-xl border border-[#1B519F] px-4 py-2 text-sm font-black text-[#1B519F] transition hover:bg-[#EEF5FF] disabled:cursor-not-allowed disabled:opacity-50"
            >
              + Add Certification
            </button>
          </div>

          <div className="mt-5 space-y-5">
            {certifications.map(
              (item, index) => (
                <div
                  key={item.id}
                  className="rounded-2xl border border-slate-200 bg-slate-50 p-5"
                >
                  <div className="flex items-center justify-between gap-4">
                    <h4 className="font-black text-slate-800">
                      Certification{" "}
                      {index + 1}
                    </h4>

                    <button
                      type="button"
                      onClick={() =>
                        removeCertification(
                          item.id,
                        )
                      }
                      className="text-sm font-bold text-red-600 hover:underline"
                    >
                      Remove
                    </button>
                  </div>

                  <div className="mt-5 grid gap-5 md:grid-cols-2">
                    <Field
                      label="Certification Name"
                      required
                    >
                      <input
                        value={item.name}
                        onChange={(event) =>
                          updateCertification(
                            item.id,
                            {
                              name:
                                event.target
                                  .value,
                            },
                          )
                        }
                        required
                        className={inputClass}
                      />
                    </Field>

                    <Field
                      label="Issuing Organization"
                      required
                    >
                      <input
                        value={item.issuer}
                        onChange={(event) =>
                          updateCertification(
                            item.id,
                            {
                              issuer:
                                event.target
                                  .value,
                            },
                          )
                        }
                        required
                        className={inputClass}
                      />
                    </Field>

                    <Field label="Issue Date">
                      <input
                        type="date"
                        value={item.issueDate}
                        onChange={(event) =>
                          updateCertification(
                            item.id,
                            {
                              issueDate:
                                event.target
                                  .value,
                            },
                          )
                        }
                        className={inputClass}
                      />
                    </Field>

                    <Field label="Expiry Date">
                      <input
                        type="date"
                        value={item.expiryDate}
                        onChange={(event) =>
                          updateCertification(
                            item.id,
                            {
                              expiryDate:
                                event.target
                                  .value,
                            },
                          )
                        }
                        className={inputClass}
                      />
                    </Field>

                    <Field label="Credential ID">
                      <input
                        value={
                          item.credentialId
                        }
                        onChange={(event) =>
                          updateCertification(
                            item.id,
                            {
                              credentialId:
                                event.target
                                  .value,
                            },
                          )
                        }
                        className={inputClass}
                      />
                    </Field>

                    <Field label="Credential URL">
                      <input
                        type="url"
                        value={
                          item.credentialUrl
                        }
                        onChange={(event) =>
                          updateCertification(
                            item.id,
                            {
                              credentialUrl:
                                event.target
                                  .value,
                            },
                          )
                        }
                        className={inputClass}
                        placeholder="https://..."
                      />
                    </Field>

                    <div className="md:col-span-2">
                      <Field
                        label="Certification PDF"
                        required
                        hint="PDF only. Maximum 5 MB."
                      >
                        <input
                          type="file"
                          required
                          accept=".pdf,application/pdf"
                          onChange={(event) =>
                            updateCertification(
                              item.id,
                              {
                                file:
                                  event.target
                                    .files?.[0] ??
                                  null,
                              },
                            )
                          }
                          className={fileClass}
                        />
                      </Field>
                    </div>
                  </div>
                </div>
              ),
            )}
          </div>
        </div>
      </Section>

      <Section
        number="06"
        title="Motivation & Practical Value"
        description="Explain why you want to train and what learners will gain from you."
      >
        <div className="space-y-5">
          <Field
            label="Why do you want to become a Smartera Hub trainer?"
            required
          >
            <textarea
              name="motivation"
              required
              minLength={20}
              maxLength={2000}
              rows={5}
              className={textareaClass}
            />
          </Field>

          <Field
            label="What practical value can you provide to learners?"
            required
          >
            <textarea
              name="practicalValue"
              required
              minLength={20}
              maxLength={2000}
              rows={5}
              className={textareaClass}
            />
          </Field>

          <Field label="Additional Information">
            <textarea
              name="additionalInformation"
              maxLength={2000}
              rows={4}
              className={textareaClass}
            />
          </Field>
        </div>
      </Section>

      <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <label className="flex items-start gap-3">
          <input
            type="checkbox"
            name="consent"
            required
            className="mt-1 h-4 w-4"
          />

          <span className="text-sm leading-6 text-slate-600">
            I confirm that the information
            provided in this application
            is accurate and may be reviewed
            by Smartera Hub for trainer
            selection purposes.
          </span>
        </label>

        <button
          type="submit"
          disabled={submitting}
          className="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-[#1B519F] px-6 py-3 text-sm font-black text-white shadow-sm transition hover:bg-[#143f7d] disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
        >
          {submitting
            ? "Submitting..."
            : "Submit Trainer Application"}
        </button>
      </div>
    </form>
  );
}

function Section({
  number,
  title,
  description,
  children,
}: {
  number: string;
  title: string;
  description: string;
  children: React.ReactNode;
}) {
  return (
    <section className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <div className="mb-6 flex items-start gap-4">
        <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#EEF5FF] text-xs font-black text-[#1B519F]">
          {number}
        </span>

        <div>
          <h2 className="text-xl font-black text-[#1B519F]">
            {title}
          </h2>

          <p className="mt-1 text-sm leading-6 text-slate-500">
            {description}
          </p>
        </div>
      </div>

      {children}
    </section>
  );
}

function Field({
  label,
  required = false,
  hint,
  children,
}: {
  label: string;
  required?: boolean;
  hint?: string;
  children: React.ReactNode;
}) {
  return (
    <label className="block">
      <span className="mb-2 block text-sm font-black text-slate-800">
        {label}
        {required ? (
          <span className="ml-1 text-red-500">
            *
          </span>
        ) : null}
      </span>

      {children}

      {hint ? (
        <span className="mt-2 block text-xs leading-5 text-slate-500">
          {hint}
        </span>
      ) : null}
    </label>
  );
}


"use client";

import {
  useState,
  type FormEvent,
} from "react";
import { submitPublicForm } from "@/features/web-submissions/public-submissions.service";
import { PublicSubmissionToast } from "@/features/web-submissions/public-submission-toast";

export function TrainerRequestForm({
  trainerName,
  trainerSlug,
}: {
  trainerName: string;
  trainerSlug: string;
}) {
  const [notice, setNotice] =
    useState(false);
  const [submissionError, setSubmissionError] = useState("");
  const [fieldErrors, setFieldErrors] = useState<Record<string, string>>({});

  const fieldLabels: Record<string, string> = {
    organizationName: "Company / Organization Name",
    contactPerson: "Contact Person",
    email: "Business Email",
    phone: "Phone",
    trainingNeeded: "Training Needed",
    participants: "Number of Participants",
    preferredDate: "Preferred Date",
    trainingMode: "Training Mode",
    location: "Location",
    duration: "Expected Duration",
    message: "Training Requirements / Message",
  };

  function getValidationMessage(
    element: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
  ) {
    const label = fieldLabels[element.name] ?? "This field";
    const validity = element.validity;

    if (validity.customError && element.validationMessage) {
      return element.validationMessage;
    }

    if (validity.valueMissing) {
      return `${label} is required.`;
    }

    if (element.name === "email" && validity.typeMismatch) {
      return "Enter a valid business email address.";
    }

    if (element.name === "phone" && validity.patternMismatch) {
      return "Enter a valid phone number using digits, +, spaces, parentheses, or hyphen.";
    }

    if (
      (element instanceof HTMLInputElement ||
        element instanceof HTMLTextAreaElement) &&
      validity.tooShort
    ) {
      return `${label} must contain at least ${element.minLength} characters.`;
    }

    if (
      (element instanceof HTMLInputElement ||
        element instanceof HTMLTextAreaElement) &&
      validity.tooLong
    ) {
      return `${label} must contain no more than ${element.maxLength} characters.`;
    }

    if (
      element instanceof HTMLInputElement &&
      validity.rangeUnderflow
    ) {
      if (element.name === "preferredDate") {
        return "Choose a future date. Today and past dates are not allowed.";
      }

      return `${label} must be at least ${element.min}.`;
    }

    if (
      element instanceof HTMLInputElement &&
      validity.rangeOverflow
    ) {
      return `${label} must not be greater than ${element.max}.`;
    }

    if (
      element instanceof HTMLInputElement &&
      validity.stepMismatch
    ) {
      return `${label} must be a whole number.`;
    }

    if (
      element instanceof HTMLInputElement &&
      validity.badInput
    ) {
      return `Enter a valid value for ${label}.`;
    }

    if (validity.patternMismatch) {
      return `${label} has an invalid format.`;
    }

    return element.validationMessage || `Check ${label}.`;
  }

  function handleInvalid(event: FormEvent<HTMLFormElement>) {
    const element = event.target;

    if (
      !(
        element instanceof HTMLInputElement ||
        element instanceof HTMLTextAreaElement ||
        element instanceof HTMLSelectElement
      ) ||
      !element.name
    ) {
      return;
    }

    event.preventDefault();

    const message = getValidationMessage(element);

    setFieldErrors((current) => ({
      ...current,
      [element.name]: message,
    }));

    setSubmissionError((current) => current || message);
  }

  function handleInput(event: FormEvent<HTMLFormElement>) {
    const element = event.target;

    if (
      !(
        element instanceof HTMLInputElement ||
        element instanceof HTMLTextAreaElement ||
        element instanceof HTMLSelectElement
      ) ||
      !element.name
    ) {
      return;
    }

    element.setCustomValidity("");

    setFieldErrors((current) => {
      if (!current[element.name]) {
        return current;
      }

      const next = { ...current };
      delete next[element.name];
      return next;
    });

    setSubmissionError("");
  }

  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);

  const minimumPreferredDate =
    `${tomorrow.getFullYear()}-${String(tomorrow.getMonth() + 1).padStart(2, "0")}-${String(tomorrow.getDate()).padStart(2, "0")}`;

  async function submit(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();
    setSubmissionError("");
    const form = event.currentTarget;

    try {
      await submitPublicForm("trainers", form, {
        trainerName,
        trainerSlug,
      });

      setNotice(true);
      form.reset();
    } catch (error) {
      setSubmissionError(
        error instanceof Error
          ? error.message
          : "Unable to submit your request. Please try again.",
      );
    }
  }

  const input =
    "trainer-input mt-2 h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-900 outline-none focus:border-[#1B519F] focus:ring-2 focus:ring-[#1B519F]/10";

  return (
    <form
      onSubmit={submit}
      onInvalidCapture={handleInvalid}
      onInputCapture={handleInput}
      className="trainer-card rounded-[22px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
    >
      <PublicSubmissionToast message={submissionError} variant="error" onDismiss={() => setSubmissionError("")} />
      <p className="text-xs font-black uppercase tracking-[0.18em] text-[#F59223]">
        Corporate Request
      </p>

      <h2 className="mt-2 text-2xl font-black text-[#1B519F]">
        Request This Trainer
      </h2>

      <p className="trainer-muted mt-3 text-sm leading-6 text-slate-600">
        Your request will go through
        Smartera Hub. Smartera will review
        the training requirement and
        coordinate with the trainer.
      </p>

      <div className="mt-6 rounded-xl bg-[#EEF5FF] p-4">
        <p className="text-[10px] font-black uppercase tracking-wider text-slate-400">
          Selected Trainer
        </p>

        <p className="mt-1 text-sm font-black text-[#1B519F]">
          {trainerName}
        </p>
      </div>

      <div className="mt-6 grid gap-5 sm:grid-cols-2">
        <label className="text-xs font-bold text-[#1B519F]">
          Company / Organization Name
          <input
            name="organizationName"
            minLength={2}
            aria-describedby="organizationNameError"
            required
            maxLength={150}
            className={input}
          />
          {fieldErrors["organizationName"] && (
            <span
              id="organizationNameError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["organizationName"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Contact Person
          <input
            name="contactPerson"
            minLength={2}
            aria-describedby="contactPersonError"
            required
            maxLength={100}
            className={input}
          />
          {fieldErrors["contactPerson"] && (
            <span
              id="contactPersonError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["contactPerson"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Business Email
          <input
            name="email"
            aria-describedby="emailError"
            type="email"
            required
            maxLength={150}
            className={input}
          />
          {fieldErrors["email"] && (
            <span
              id="emailError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["email"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Phone
          <input
            name="phone"
            aria-describedby="phoneError"
            type="tel"
            required
            pattern="[+0-9 \(\)\-]+"
            minLength={7}
            maxLength={20}
            className={input}
          />
          {fieldErrors["phone"] && (
            <span
              id="phoneError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["phone"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F] sm:col-span-2">
          Training Needed
          <input
            name="trainingNeeded"
            minLength={10}
            aria-describedby="trainingNeededError"
            required
            maxLength={180}
            placeholder="Example: Sales & Marketing Training"
            className={input}
          />
          {fieldErrors["trainingNeeded"] && (
            <span
              id="trainingNeededError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["trainingNeeded"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Number of Participants
          <input
            name="participants"
            aria-describedby="participantsError"
            type="number"
            min={1}
            max={5000}
            required
            className={input}
          />
          {fieldErrors["participants"] && (
            <span
              id="participantsError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["participants"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Preferred Date
          <input
            name="preferredDate"
            aria-describedby="preferredDateError"
            type="date"
            min={minimumPreferredDate}
            className={input}
          />
          {fieldErrors["preferredDate"] && (
            <span
              id="preferredDateError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["preferredDate"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Training Mode
          <select
            name="trainingMode"
            aria-describedby="trainingModeError"
            required
            defaultValue=""
            className={input}
          >
            <option value="">
              Select mode
            </option>
            <option value="on-site">On-site</option>
            <option value="online">Online</option>
            <option value="hybrid">Hybrid</option>
          </select>
          {fieldErrors["trainingMode"] && (
            <span
              id="trainingModeError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["trainingMode"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Location
          <input
            name="location"
            minLength={3}
            aria-describedby="locationError"
            maxLength={150}
            className={input}
          />
          {fieldErrors["location"] && (
            <span
              id="locationError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["location"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F] sm:col-span-2">
          Expected Duration
          <input
            name="duration"
            minLength={2}
            aria-describedby="durationError"
            maxLength={100}
            placeholder="Example: 2 days"
            className={input}
          />
          {fieldErrors["duration"] && (
            <span
              id="durationError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["duration"]}
            </span>
          )}
        </label>

        <label className="text-xs font-bold text-[#1B519F] sm:col-span-2">
          Training Requirements / Message
          <textarea
            name="message"
            aria-describedby="messageError"
            required
            minLength={20}
            maxLength={2000}
            className="trainer-input mt-2 min-h-32 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-900 outline-none focus:border-[#1B519F] focus:ring-2 focus:ring-[#1B519F]/10"
          />
          {fieldErrors["message"] && (
            <span
              id="messageError"
              role="alert"
              className="mt-1 block text-[11px] font-semibold leading-4 text-red-600"
            >
              {fieldErrors["message"]}
            </span>
          )}
        </label>
      </div>

      <PublicSubmissionToast message={notice ? "Your request has been submitted successfully." : ""} variant="success" onDismiss={() => setNotice(false)} />

      <button
        type="submit"
        className="mt-6 h-11 rounded-xl bg-[#1B519F] px-6 text-sm font-black text-white transition hover:bg-[#174783]"
      >
        Submit Trainer Request
      </button>

      <input
        type="hidden"
        name="trainerSlug"
        value={trainerSlug}
      />
    </form>
  );
}










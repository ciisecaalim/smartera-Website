"use client";

import {
  useState,
  type FormEvent,
} from "react";
import { submitPublicForm } from "@/features/web-submissions/public-submissions.service";
import { PublicSubmissionToast } from "@/features/web-submissions/public-submission-toast";

export function TrainerRequestForm({
  trainerName,
  trainerSlug,
}: {
  trainerName: string;
  trainerSlug: string;
}) {
  const [notice, setNotice] =
    useState(false);
  const [submissionError, setSubmissionError] = useState("");

  async function submit(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();
    setSubmissionError("");
    try { await submitPublicForm("trainers", event.currentTarget, { trainerName, trainerSlug }); setNotice(true); event.currentTarget.reset(); } catch (error) { setSubmissionError(error instanceof Error ? error.message : "Unable to submit your request. Please try again."); }
  }

  const input =
    "trainer-input mt-2 h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-900 outline-none focus:border-[#1B519F] focus:ring-2 focus:ring-[#1B519F]/10";

  return (
    <form
      onSubmit={submit}
      className="trainer-card rounded-[22px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
    >
      <PublicSubmissionToast message={submissionError} variant="error" onDismiss={() => setSubmissionError("")} />
      <p className="text-xs font-black uppercase tracking-[0.18em] text-[#F59223]">
        Corporate Request
      </p>

      <h2 className="mt-2 text-2xl font-black text-[#1B519F]">
        Request This Trainer
      </h2>

      <p className="trainer-muted mt-3 text-sm leading-6 text-slate-600">
        Your request will go through
        Smartera Hub. Smartera will review
        the training requirement and
        coordinate with the trainer.
      </p>

      <div className="mt-6 rounded-xl bg-[#EEF5FF] p-4">
        <p className="text-[10px] font-black uppercase tracking-wider text-slate-400">
          Selected Trainer
        </p>

        <p className="mt-1 text-sm font-black text-[#1B519F]">
          {trainerName}
        </p>
      </div>

      <div className="mt-6 grid gap-5 sm:grid-cols-2">
        <label className="text-xs font-bold text-[#1B519F]">
          Company / Organization Name
          <input
            name="organizationName"
            required
            maxLength={150}
            className={input}
          />
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Contact Person
          <input
            name="contactPerson"
            required
            maxLength={100}
            className={input}
          />
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Business Email
          <input
            name="email"
            type="email"
            required
            maxLength={150}
            className={input}
          />
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Phone
          <input
            name="phone"
            type="tel"
            required
            pattern="[+0-9 ()-]+"
            minLength={7}
            maxLength={20}
            className={input}
          />
        </label>

        <label className="text-xs font-bold text-[#1B519F] sm:col-span-2">
          Training Needed
          <input
            name="trainingNeeded"
            required
            maxLength={180}
            placeholder="Example: Sales & Marketing Training"
            className={input}
          />
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Number of Participants
          <input
            name="participants"
            type="number"
            min={1}
            max={5000}
            required
            className={input}
          />
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Preferred Date
          <input
            name="preferredDate"
            type="date"
            className={input}
          />
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Training Mode
          <select
            name="trainingMode"
            required
            defaultValue=""
            className={input}
          >
            <option value="">
              Select mode
            </option>
            <option>On-site</option>
            <option>Online</option>
            <option>Hybrid</option>
          </select>
        </label>

        <label className="text-xs font-bold text-[#1B519F]">
          Location
          <input
            name="location"
            maxLength={150}
            className={input}
          />
        </label>

        <label className="text-xs font-bold text-[#1B519F] sm:col-span-2">
          Expected Duration
          <input
            name="duration"
            maxLength={100}
            placeholder="Example: 2 days"
            className={input}
          />
        </label>

        <label className="text-xs font-bold text-[#1B519F] sm:col-span-2">
          Training Requirements / Message
          <textarea
            name="message"
            required
            minLength={20}
            maxLength={2000}
            className="trainer-input mt-2 min-h-32 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-900 outline-none focus:border-[#1B519F] focus:ring-2 focus:ring-[#1B519F]/10"
          />
        </label>
      </div>

      <PublicSubmissionToast message={notice ? "Your request has been submitted successfully." : ""} variant="success" onDismiss={() => setNotice(false)} />

      <button
        type="submit"
        className="mt-6 h-11 rounded-xl bg-[#1B519F] px-6 text-sm font-black text-white transition hover:bg-[#174783]"
      >
        Submit Trainer Request
      </button>

      <input
        type="hidden"
        name="trainerSlug"
        value={trainerSlug}
      />
    </form>
  );
}

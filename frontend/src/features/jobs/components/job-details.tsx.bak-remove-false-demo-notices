export function JobDetails({job}:{job:Job}){const status=jobStatusConfig[job.status];const facts=[["Company",job.companyName],["Category",job.category],["Location",job.location],["Employment Type",job.employmentType],["Work Mode",job.workMode],["Experience",job.experienceLevel],["Application Deadline",job.applicationDeadline]].filter((fact):fact is[string,string]=>Boolean(fact[1]));return <><section className="bg-[#F5F9FF] py-7"><Container><Link href="/opportunities/jobs" className="inline-flex items-center gap-2 text-xs font-black text-[#1B519F] hover:-translate-x-0.5">Back to Jobs</Link><div className="mt-5 rounded-[24px] border border-slate-200 bg-white p-6 shadow-[0_12px_35px_rgba(6,59,134,.07)] sm:p-8"><div className="flex flex-col gap-5 sm:flex-row sm:items-start"><EmployerAvatar company={job.companyName} large/><div className="min-w-0 flex-1"><div className="flex flex-wrap items-center gap-2"><span className="rounded-full bg-[#FFF3DF] px-2.5 py-1 text-[9px] font-black uppercase text-[#F59223]">Demo</span><span className="rounded-full bg-emerald-50 px-2.5 py-1 text-[9px] font-black uppercase text-emerald-700">{status.label}</span></div><h1 className="mt-3 text-[clamp(2rem,4vw,3.3rem)] font-black leading-tight text-[#1B519F]">{job.title}</h1><p className="mt-1 text-sm font-bold text-slate-500">{job.companyName}</p><div className="mt-4 flex flex-wrap gap-2 text-[11px] font-bold text-slate-500"><span> {job.location}</span><span> {job.employmentType}</span><span> {job.workMode}</span><span> {job.experienceLevel}</span><span> {job.category}</span></div></div></div></div></Container></section><section className="bg-[#FBFDFF] py-10 lg:py-14"><Container className="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_320px]"><main className="space-y-5"><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">Job Overview</h2><p className="mt-4 text-sm leading-7 text-slate-600">{job.summary}</p><p className="mt-3 rounded-xl bg-[#FFF9EF] p-3 text-xs leading-5 text-[#F59223]">This is a fictional DEMO_ONLY record for development interface testing. It is not a live vacancy.</p></section><ListSection title="Responsibilities" items={job.responsibilities}/><ListSection title="Requirements" items={job.requirements}/><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">Required Skills</h2><div className="mt-4 flex flex-wrap gap-2">{job.skills.map(skill=><span key={skill} className="rounded-full bg-[#EEF5FF] px-3 py-1.5 text-xs font-bold text-[#1B519F]">{skill}</span>)}</div></section><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">Education & Experience</h2><p className="mt-4 text-sm leading-7 text-slate-600">Experience level: <strong>{job.experienceLevel}</strong>. Review the requirements above for the skills expected in this development fixture.</p></section><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">About the Company</h2><p className="mt-4 text-sm leading-7 text-slate-600">{job.companyName} is a fictional company name used only for development testing. No employer relationship or verification is implied.</p></section><section className="rounded-2xl border border-slate-200 bg-white p-6"><h2 className="text-xl font-black text-[#1B519F]">Application Information</h2><p className="mt-4 text-sm leading-7 text-slate-600">The application interface is available for testing, but submissions are not stored until a secure application service is connected.</p></section></main><aside className="lg:sticky lg:top-28"><div className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_12px_32px_rgba(6,59,134,.08)]"><div className="bg-[#1B519F] p-5 text-white"><h2 className="text-lg font-black">Job Summary</h2></div><dl className="divide-y divide-slate-100 p-5">{facts.map(([label,value])=><div key={label} className="flex justify-between gap-4 py-3 text-xs"><dt className="text-slate-500">{label}</dt><dd className="text-right font-black text-[#1B519F]">{value}</dd></div>)}</dl><div className="px-5 pb-5">{status.canApply?<Link href={`/opportunities/jobs/${job.slug}/apply`} className="flex h-11 items-center justify-center rounded-xl bg-[#1B519F] text-sm font-black text-white hover:bg-[#174783]">Apply Now</Link>:<p className="rounded-xl bg-slate-100 p-3 text-center text-xs font-bold text-slate-500">{status.label}</p>}<Link href="/opportunities/jobs" className="mt-3 flex h-9 items-center justify-center text-xs font-bold text-[#1B519F]">Save is available on the Jobs page</Link></div></div></aside></Container></section></>}


import Link from "next/link";import{Container}from"@/components/ui/container";import type{Job}from"@/features/jobs/types/jobs.types";import{EmployerAvatar}from"./employer-avatar";import{jobStatusConfig}from"@/features/jobs/utils/jobs.utils";

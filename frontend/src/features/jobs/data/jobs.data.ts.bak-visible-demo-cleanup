export const getPublishedJobs = () =>
  jobs.filter(
    (job) =>
      job.published &&
      job.status !== "draft" &&
      job.status !== "archived" &&
      job.status !== "closed" &&
      job.status !== "filled",
  );

export const getFeaturedJobs = () =>
  getPublishedJobs().filter((job) => job.featured);

export const getJobBySlug = (slug: string) =>
  getPublishedJobs().find((job) => job.slug === slug);

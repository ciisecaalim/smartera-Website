"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { useEffect, useRef, useState } from "react";
import { BrandLogo } from "@/components/layout/brand-logo";
import { opportunityNavigation, primaryNavigation } from "@/config/navigation";

function Chevron({ open = false }: { open?: boolean }) {
  return <svg viewBox="0 0 20 20" className={`h-4 w-4 transition-transform duration-200 ${open ? "rotate-180" : ""}`} fill="none" stroke="currentColor" strokeWidth="1.8" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg>;
}

/** Fixed, accessible global navigation with desktop dropdown and mobile menu. */
export function Navbar() {
  const pathname = usePathname();
  const [dropdownOpen, setDropdownOpen] = useState(false);
  const [mobileOpen, setMobileOpen] = useState(false);
  const [mobileOppOpen, setMobileOppOpen] = useState(false);
  const dropdownRef = useRef<HTMLDivElement>(null);

  const closeMenus = () => { setDropdownOpen(false); setMobileOpen(false); setMobileOppOpen(false); };
  const active = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
  const opportunitiesActive = pathname.startsWith("/opportunities");

  useEffect(() => {
    const onKey = (event: KeyboardEvent) => { if (event.key === "Escape") closeMenus(); };
    const onPointer = (event: MouseEvent) => {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target as Node)) setDropdownOpen(false);
    };
    document.addEventListener("keydown", onKey);
    document.addEventListener("mousedown", onPointer);
    return () => { document.removeEventListener("keydown", onKey); document.removeEventListener("mousedown", onPointer); };
  }, []);

  const before = primaryNavigation.slice(0, 2);
  const after = primaryNavigation.slice(2);

  return (
    <header className="fixed inset-x-0 top-0 z-50 border-b border-slate-200/70 bg-white/95 shadow-[0_10px_35px_rgba(8,43,87,.07)] backdrop-blur-xl">
      <div className="mx-auto grid h-20 w-full max-w-[1400px] grid-cols-[1fr_auto] items-center gap-4 px-4 sm:px-6 xl:grid-cols-[1fr_auto_1fr] xl:px-8">
        <div className="justify-self-start"><BrandLogo /></div>
        <nav className="hidden items-center gap-1 xl:flex" aria-label="Primary navigation">
          {before.map((item) => <Link key={item.href} href={item.href} onClick={closeMenus} className={`relative rounded-xl px-4 py-3 text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F6A21A] ${active(item.href) ? "text-[#075EDE]" : "text-slate-800 hover:text-[#075EDE]"}`}>{item.label}{active(item.href) ? <span className="absolute inset-x-4 -bottom-0.5 h-0.5 rounded-full bg-[#F6A21A]" /> : null}</Link>)}
          <div ref={dropdownRef} className="relative" onMouseEnter={() => setDropdownOpen(true)} onMouseLeave={() => setDropdownOpen(false)}>
            <button type="button" onClick={() => setDropdownOpen((v) => !v)} aria-expanded={dropdownOpen} aria-controls="opportunities-menu" className={`relative flex items-center gap-1.5 rounded-xl px-4 py-3 text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F6A21A] ${opportunitiesActive || dropdownOpen ? "text-[#075EDE]" : "text-slate-800 hover:text-[#075EDE]"}`}>
              Opportunities <Chevron open={dropdownOpen} />{opportunitiesActive ? <span className="absolute inset-x-4 -bottom-0.5 h-0.5 rounded-full bg-[#F6A21A]" /> : null}
            </button>
            {dropdownOpen ? <div id="opportunities-menu" className="absolute left-1/2 top-[calc(100%+12px)] z-[70] w-[390px] before:absolute before:-top-3 before:left-0 before:h-3 before:w-full before:content-[''] -translate-x-1/2 rounded-[22px] border border-slate-200 bg-white p-3 shadow-[0_28px_70px_rgba(8,43,87,.16)]">
              {opportunityNavigation.map((item) => <Link key={item.href} href={item.href} onClick={closeMenus} className="group flex items-start justify-between gap-4 rounded-2xl px-4 py-3 transition-all duration-200 hover:bg-[#F4F8FD] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F6A21A]"><span><span className="block text-sm font-extrabold text-[#063B86]">{item.label}</span><span className="mt-1 block text-xs leading-5 text-slate-500">{item.description}</span></span><span className="mt-1 text-[#F6A21A] transition-transform group-hover:translate-x-1">→</span></Link>)}
            </div> : null}
          </div>
          {after.map((item) => <Link key={item.href} href={item.href} onClick={closeMenus} className={`relative rounded-xl px-4 py-3 text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F6A21A] ${active(item.href) ? "text-[#075EDE]" : "text-slate-800 hover:text-[#075EDE]"}`}>{item.label}{active(item.href) ? <span className="absolute inset-x-4 -bottom-0.5 h-0.5 rounded-full bg-[#F6A21A]" /> : null}</Link>)}
        </nav>
        <div className="flex items-center gap-3 justify-self-end">
          <Link href="/opportunities" onClick={closeMenus} className="hidden rounded-xl bg-[#075EDE] px-5 py-3 text-sm font-extrabold text-white shadow-[0_12px_30px_rgba(22,85,163,.2)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#064FC0] hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F6A21A] xl:inline-flex">Explore Opportunities <span className="ml-2">→</span></Link>
          <button type="button" onClick={() => setMobileOpen((v) => !v)} aria-expanded={mobileOpen} aria-controls="mobile-navigation" aria-label={mobileOpen ? "Close navigation" : "Open navigation"} className="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-xl font-bold text-[#075EDE] transition-colors hover:border-[#F6A21A] hover:text-[#F6A21A] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F6A21A] xl:hidden">{mobileOpen ? "Ã—" : "â˜°"}</button>
        </div>
      </div>
      {mobileOpen ? <nav id="mobile-navigation" className="border-t border-slate-100 bg-white px-4 py-4 shadow-xl xl:hidden" aria-label="Mobile navigation"><div className="mx-auto max-w-[1240px] space-y-1">
        {before.map((item) => <Link key={item.href} href={item.href} onClick={closeMenus} className={`block rounded-xl px-4 py-3 text-sm font-bold ${active(item.href) ? "bg-[#EEF5FF] text-[#075EDE]" : "text-slate-800 hover:bg-slate-50"}`}>{item.label}</Link>)}
        <button type="button" onClick={() => setMobileOppOpen((v) => !v)} aria-expanded={mobileOppOpen} className={`flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm font-bold ${opportunitiesActive ? "bg-[#EEF5FF] text-[#075EDE]" : "text-slate-800 hover:bg-slate-50"}`}>Opportunities <Chevron open={mobileOppOpen} /></button>
        {mobileOppOpen ? <div className="ml-4 space-y-1 border-l-2 border-[#F6A21A]/35 pl-3">{opportunityNavigation.map((item) => <Link key={item.href} href={item.href} onClick={closeMenus} className="block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-[#EEF5FF] hover:text-[#075EDE]">{item.label}</Link>)}</div> : null}
        {after.map((item) => <Link key={item.href} href={item.href} onClick={closeMenus} className={`block rounded-xl px-4 py-3 text-sm font-bold ${active(item.href) ? "bg-[#EEF5FF] text-[#075EDE]" : "text-slate-800 hover:bg-slate-50"}`}>{item.label}</Link>)}
        <Link href="/opportunities" onClick={closeMenus} className="mt-3 flex items-center justify-center rounded-xl bg-[#075EDE] px-5 py-3 text-sm font-extrabold text-white">Explore Opportunities →</Link>
      </div></nav> : null}
    </header>
  );
}


